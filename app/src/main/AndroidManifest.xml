<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Spec section 3: permissions of the alarm core (stage 2). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarms: setAlarmClock needs no runtime grant; USE_EXACT_ALARM
         is the alarm-app manifest grant (spec 3), SCHEDULE_EXACT_ALARM is
         the declared reserve for future flows. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Ringing screen over the lock screen (spec 4.1.3). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Re-arming schedules after reboot and time changes (spec section 5). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Ringing foreground service of type mediaPlayback (spec section 2). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".WakeProofApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WakeProof">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Marks WakeProof as an alarm app: Android 14+ auto-grants
                 USE_FULL_SCREEN_INTENT to apps handling SHOW_ALARMS. -->
            <intent-filter>
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Full-screen ringing UI over the lock screen (spec 4.1.3). -->
        <activity
            android:name=".presentation.ui.ringing.RingingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/ringing_notification_title"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WakeProof"
            android:turnScreenOn="true" />

        <service
            android:name=".service.RingingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".receiver.AlarmReceiver"
            android:exported="false" />

        <!-- Exported because BOOT_COMPLETED is a protected broadcast only
             the system can send; non-exported receivers are skipped by the
             broadcast resolver for implicit system broadcasts. -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Exported for the same reason: TIME_SET / TIMEZONE_CHANGED are
             protected system-only broadcasts. -->
        <receiver
            android:name=".receiver.TimeChangedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
